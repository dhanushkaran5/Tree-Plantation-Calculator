# PostgreSQL Database Connection String (Render PostgreSQL or Supabase)
DATABASE_URL=postgresql://username:password@host:5432/database

# Application Security Secret Key
SECRET_KEY=generate-a-secure-random-key-for-production

# API Endpoint URL for Frontend Communication
API_URL=https://tree-plantation-calculator.onrender.com/api

# Allowed CORS Origins
FRONTEND_URL=https://tree-plantation-calculator.onrender.com

# Backend Host URL
BACKEND_URL=https://tree-plantation-calculator.onrender.com

# Server Environment Configuration
PORT=5000
FLASK_ENV=production
DEBUG=false
